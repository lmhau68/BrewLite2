><mxCell id="e10" value="&lt;b&gt;[10]&lt;/b&gt; pull image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#7B3FA0;fontColor=#222222;exitX=0.8804;exitY=0.0;entryX=0.5682;entryY=1.0;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="host" target="reg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="&lt;b&gt;[11]&lt;/b&gt; smoke test" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#7B3FA0;fontColor=#222222;exitX=0.7344;exitY=1.0;entryX=0.6087;entryY=0.0;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="cd_job" target="host"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="&lt;b&gt;[12]&lt;/b&gt; HTTP :3000 / :3001" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#777777;fontColor=#222222;exitX=0.5;exitY=1.0;entryX=0.4074;entryY=0.0;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="user" target="local"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eenv" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#777777;fontColor=#222222;exitX=0.5;exitY=0.0;entryX=0.5119;entryY=1.0;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="env" target="c_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>