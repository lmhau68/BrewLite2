<mxfile host="app.diagrams.net"><diagram id="deploy" name="Deployment"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;BrewLite – Deployment Diagram (Task 3.2) · Production trên Render (COMP-PLATFORM) · Local Docker Compose · CI/CD GitHub Actions + GHCR&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1340" height="30" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;git push / Pull Request" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="210" height="71" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;RANH GIỚI CI/CD (GitHub Actions + GHCR)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="50" width="920" height="240" as="geometry"/></mxCell><mxCell id="ci_job" value="&lt;b&gt;COMP-CI · ci.yml&lt;/b&gt;&lt;br&gt;(PR · push main/dev)&lt;br&gt;Install → Lint → Test → Build&lt;br&gt;+ Docker build &amp;amp; chạy thử" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="ci"><mxGeometry x="15" y="40" width="270" height="95" as="geometry"/></mxCell><mxCell id="cd_job" value="&lt;b&gt;COMP-CD · cd.yml (workflow_run, chỉ main)&lt;/b&gt;&lt;br&gt;Quality gate → Build &amp;amp; push image&lt;br&gt;→ Deploy Hook (api, web) → chờ live&lt;br&gt;→ Smoke test → Rollback nếu lỗi" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="ci"><mxGeometry x="325" y="40" width="320" height="95" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;COMP-REG · GHCR&lt;/b&gt;&lt;br&gt;brewlite2-api · brewlite2-web&lt;br&gt;tag sha-&amp;lt;SHA&amp;gt; · latest" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="ci"><mxGeometry x="685" y="40" width="220" height="95" as="geometry"/></mxCell><mxCell id="gh_sec" value="&lt;b&gt;GitHub Secrets / Variables&lt;/b&gt;&lt;br&gt;Secrets: RENDER_API_DEPLOY_HOOK_URL,&lt;br&gt;RENDER_WEB_DEPLOY_HOOK_URL, RENDER_API_KEY&lt;br&gt;Variables: RENDER_API_URL, RENDER_WEB_URL,&lt;br&gt;RENDER_*_SERVICE_ID" style="shape=note;size=14;darkOpacity=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;" vertex="1" parent="ci"><mxGeometry x="15" y="148" width="300" height="85" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Node 1: Thiết bị người dùng&lt;/b&gt;&lt;br&gt;(điện thoại, máy chấm, máy dev)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;strokeWidth=2;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="220" height="215" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;COMP-BROWSER&lt;/b&gt;&lt;br&gt;Trình duyệt chạy&lt;br&gt;Next.js mobile-first / PWA" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="user"><mxGeometry x="15" y="48" width="180" height="130" as="geometry"/></mxCell><mxCell id="local" value="&lt;b&gt;Node 4: Máy Local (COMP-LOCAL)&lt;/b&gt;&lt;br&gt;Docker Compose (dev/test)&lt;br&gt;mạng bridge brewlite-net&lt;br&gt;&lt;br&gt;db: postgres:16 + volume pgdata&lt;br&gt;(không publish cổng 5432)&lt;br&gt;migrate: 1 lần (migration + seed)&lt;br&gt;api :3001 · web :3000 (publish)&lt;br&gt;&lt;br&gt;docker-compose.yml + .env" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="270" height="205" as="geometry"/></mxCell><mxCell id="host" value="&lt;b&gt;Node 2: Render Cloud (COMP-PLATFORM)&lt;/b&gt;&lt;br&gt;Singapore · Free · TLS tại Render Edge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#5B8F22;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="340" width="920" height="690" as="geometry"/></mxCell><mxCell id="c_web" value="&lt;b&gt;Render Web Service: brewlite-web&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FA8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="host"><mxGeometry x="20" y="45" width="340" height="150" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;COMP-WEB · Next.js (apps/web)&lt;/b&gt;&lt;br&gt;Existing Image: brewlite2-web:sha-&amp;lt;SHA&amp;gt;&lt;br&gt;HTTPS 443 → $PORT · Health Check: /&lt;br&gt;NEXT_PUBLIC_API_URL nhúng lúc build" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="c_web"><mxGeometry x="15" y="38" width="310" height="100" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;Vận hành Render&lt;/b&gt;&lt;br&gt;Log: stdout JSON → Render Logs&lt;br&gt;Health Check: api /health · web /&lt;br&gt;Gói Free: ngủ sau 15 phút không truy cập&lt;br&gt;Rollback: Render API (CD) hoặc Dashboard → Deploys&lt;br&gt;Public: *.onrender.com (web, api) · DB không public" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="host"><mxGeometry x="420" y="45" width="480" height="150" as="geometry"/></mxCell><mxCell id="net" value="&lt;b&gt;Render Private Network (api ↔ db)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FBF2;strokeColor=#5B8F22;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontSize=12;" vertex="1" parent="host"><mxGeometry x="10" y="215" width="900" height="335" as="geometry"/></mxCell><mxCell id="c_api" value="&lt;b&gt;Render Web Service: brewlite-api&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FA8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="net"><mxGeometry x="15" y="38" width="420" height="282" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;COMP-API · NestJS (apps/api)&lt;/b&gt;&lt;br&gt;Existing Image: brewlite2-api:sha-&amp;lt;SHA&amp;gt;&lt;br&gt;HTTPS 443 → $PORT (mặc định 10000)&lt;br&gt;Health Check: GET /health · JWT · CORS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="c_api"><mxGeometry x="15" y="38" width="390" height="92" as="geometry"/></mxCell><mxCell id="boot" value="&lt;b&gt;Khởi động API&lt;/b&gt;&lt;br&gt;start-render.sh&lt;br&gt;migration + seed&lt;br&gt;(advisory lock)&lt;br&gt;→ node dist/main.js" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="c_api"><mxGeometry x="15" y="160" width="190" height="105" as="geometry"/></mxCell><mxCell id="pay" value="&lt;b&gt;COMP-PAY&lt;/b&gt;&lt;br&gt;Mock Payment&lt;br&gt;module payments&lt;br&gt;trong API,&lt;br&gt;gọi hàm nội bộ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1;align=center;verticalAlign=middle;dashed=1;fontSize=11;" vertex="1" parent="c_api"><mxGeometry x="215" y="160" width="190" height="105" as="geometry"/></mxCell><mxCell id="c_db" value="&lt;b&gt;Render PostgreSQL: brewlite-db&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FA8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="net"><mxGeometry x="475" y="38" width="410" height="282" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;COMP-DB · PostgreSQL 16&lt;/b&gt;&lt;br&gt;5432 (Internal Database URL)&lt;br&gt;Inbound IP rules rỗng: chặn Internet" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="c_db"><mxGeometry x="15" y="38" width="380" height="92" as="geometry"/></mxCell><mxCell id="vol" value="&lt;b&gt;Managed storage 1 GB&lt;/b&gt;&lt;br&gt;(persistent · không autoscale)&lt;br&gt;DB Free hết hạn sau 30 ngày" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1;align=center;verticalAlign=middle;fontSize=10;" vertex="1" parent="c_db"><mxGeometry x="60" y="170" width="290" height="80" as="geometry"/></mxCell><mxCell id="env" value="&lt;b&gt;Render Environment Variables / Secrets (KHÔNG lưu trong repo)&lt;/b&gt;&lt;br&gt;API: DATABASE_URL (Internal URL), JWT_SECRET, CORS_ORIGIN,&lt;br&gt;DB_MIGRATIONS_RUN=false, MOCK_PAYMENT_OUTCOME, SEED_STAFF_*&lt;br&gt;Web: không có env runtime (NEXT_PUBLIC_* nhúng lúc build)" style="shape=note;size=14;darkOpacity=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;" vertex="1" parent="host"><mxGeometry x="20" y="570" width="440" height="100" as="geometry"/></mxCell><mxCell id="cfg" value="&lt;b&gt;Cấu hình dịch vụ (Render Dashboard)&lt;/b&gt;&lt;br&gt;Không dùng render.yaml: service tạo từ Existing Image (GHCR)&lt;br&gt;Docker Command api: /bin/sh /app/start-render.sh&lt;br&gt;Auto-deploy từ Git tắt: chỉ deploy qua Deploy Hook của CD" style="shape=note;size=14;darkOpacity=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=10;" vertex="1" parent="host"><mxGeometry x="480" y="570" width="420" height="100" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#1F5FA8&#x27;&gt;━ [1][2] người dùng → Render (HTTPS 443)&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#2E7D32&#x27;&gt;━ [3][4][5] nội bộ Render (api→db, hàm, storage)&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#7B3FA0&#x27;&gt;╌ [6] push/PR · [7] CI xong → CD (workflow_run)&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#7B3FA0&#x27;&gt;╌ [8] push image · [9] Deploy Hook (api, web)&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#7B3FA0&#x27;&gt;╌ [10] Render pull image · [11] smoke test HTTPS&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#777777&#x27;&gt;╌ [12] Local · mũi tên xám = cấu hình&lt;/font&gt;&lt;br&gt;&lt;b&gt;Public HTTPS: web, api · DB KHÔNG public&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="380" height="135" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;[1]&lt;/b&gt; HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#1F5FA8;fontColor=#222222;exitX=1.0;exitY=0.3846;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="browser" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="&lt;b&gt;[2]&lt;/b&gt; HTTPS 443 + JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#1F5FA8;fontColor=#222222;exitX=1.0;exitY=0.7692;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="browser" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="523"/><mxPoint x="360" y="677"/></Array></mxGeometry></mxCell><mxCell id="e3" value="&lt;b&gt;[3]&lt;/b&gt; TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#222222;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="&lt;b&gt;[4]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#222222;exitX=0.7564;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="api" target="pay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="&lt;b&gt;[5]&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#222222;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="db" target="vol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="&lt;b&gt;[6]&lt;/b&gt; push / PR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeWidt