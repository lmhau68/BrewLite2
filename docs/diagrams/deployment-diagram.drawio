tSize=12;fillColor=#FFFFFF;strokeColor=#1F5FA8;strokeWidth=2;" vertex="1" parent="net"><mxGeometry x="30" y="45" width="200" height="230" as="geometry"/></mxCell><mxCell id="web" value="COMP-WEB&lt;br&gt;Next.js (apps/web)&lt;br&gt;&lt;b&gt;cổng 3000&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c_web"><mxGeometry x="15" y="45" width="170" height="100" as="geometry"/></mxCell><mxCell id="c_api" value="container: brewlite-api" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1F5FA8;strokeWidth=2;" vertex="1" parent="net"><mxGeometry x="320" y="45" width="270" height="230" as="geometry"/></mxCell><mxCell id="api" value="COMP-API&lt;br&gt;NestJS (apps/api)&lt;br&gt;&lt;b&gt;cổng 3001&lt;/b&gt;&lt;br&gt;GET /health · JWT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="c_api"><mxGeometry x="15" y="45" width="240" height="100" as="geometry"/></mxCell><mxCell id="pay" value="Node 3: COMP-PAY&lt;br&gt;Mock Payment (module nội bộ)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;dashed=1;" vertex="1" parent="c_api"><mxGeometry x="15" y="165" width="240" height="50" as="geometry"/></mxCell><mxCell id="c_db" value="container: brewlite-db" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1F5FA8;strokeWidth=2;" vertex="1" parent="net"><mxGeometry x="640" y="45" width="180" height="230" as="geometry"/></mxCell><mxCell id="db" value="COMP-DB&lt;br&gt;PostgreSQL 16&lt;br&gt;&lt;b&gt;cổng 5432&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="c_db"><mxGeometry x="15" y="45" width="150" height="100" as="geometry"/></mxCell><mxCell id="vol" val