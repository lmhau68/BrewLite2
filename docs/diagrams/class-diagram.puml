@startuml class-diagram
skinparam classAttributeIconSize 0
hide methods

' Định nghĩa các Enum
enum OrderStatus {
    PENDING
    PAID
    PAYMENT_FAILED
    PREPARING
    READY
    COMPLETED
    CANCELLED
}

enum PaymentMethod {
    WALLET
    CARD
}

enum PaymentStatus {
    SUCCESS
    FAILED
    PENDING
}

enum UserRole {
    CUSTOMER
    STAFF
    MANAGER
}

' Định nghĩa các Class
class User {
    +String id
    +String email
    +String passwordHash
    +UserRole userRole
    +String fullName
    +String phone
    +Integer loyaltyPoints
    +DateTime createdAt
    +DateTime updatedAt
}

class Product {
    +String id
    +String name
    +String description
    +Float basePrice
    +String category
    +String imageUrl
    +Integer stockQuantity
    +Boolean isAvailable
    +DateTime createdAt
    +DateTime updatedAt
}

class ProductSize {
    +String id
    +String productId
    +String sizeName
    +Float price
}

class Topping {
    +String id
    +String name
    +Float price
    +Integer stockQuantity
}

class Order {
    +String id
    +String orderCode
    +String userId
    +OrderStatus status
    +Float totalAmount
    +Float discountAmount
    +Float finalAmount
    +DateTime createdAt
    +DateTime updatedAt
}

class OrderItem {
    +String id
    +String orderId
    +String productId
    +String sizeId
    +Integer quantity
    +Float unitPrice
    +Float subtotal
}

class Payment {
    +String id
    +String orderId
    +String transactionId
    +Float amount
    +PaymentMethod paymentMethod
    +PaymentStatus status
    +String idempotencyKey
    +String gatewayResponse
    +DateTime createdAt
}

class Promotion {
    +String id
    +String code
    +String discountType
    +Float discountValue
    +Float minOrderValue
    +Float maxDiscountAmount
    +DateTime startDate
    +DateTime endDate
    +Integer usageLimit
    +Integer usedCount
    +Boolean isActive
}

class LoyaltyTransaction {
    +String id
    +String userId
    +String orderId
    +Integer points
    +String type
    +DateTime createdAt
}

' Liên kết Enum với các Class sử dụng chúng
OrderStatus ..> Order : sử dụng
PaymentMethod ..> Payment : sử dụng
PaymentStatus ..> Payment : sử dụng
UserRole ..> User : sử dụng

' Quan hệ giữa các Class
User "1" -- "0..*" Order : đặt >
User "1" -- "0..*" LoyaltyTransaction : có >
Order "1" -- "1..*" OrderItem : chứa >
Order "0..*" -- "0..1" Promotion : áp dụng >
Order "0..*" -- "0..1" Payment : thanh toán bởi >
Order "1" -- "0..1" LoyaltyTransaction : sinh ra >
Product "1" -- "0..*" ProductSize : có kích thước >
Product "1" -- "0..*" Topping : hỗ trợ tùy chọn >
Product "1" -- "0..*" OrderItem : được tham chiếu trong >

@enduml