@startuml
skinparam classAttributeIconSize 0
skinparam backgroundColor #FAFAFA
skinparam shadowing false

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum UserRole {
  CUSTOMER
  STAFF
  MANAGER
}

class User {
  + String id
  + String email
  + String passwordHash
  + UserRole role
  + String fullName
  + String phone
  + Integer loyaltyPoints
  + DateTime createdAt
  + DateTime updatedAt
}

class Product {
  + String id
  + String name
  + String description
  + Float basePrice
  + String category
  + String imageUrl
  + Integer stockQuantity
  + Boolean isAvailable
  + DateTime createdAt
  + DateTime updatedAt
}

class ProductSize {
  + String id
  + String productId
  + String sizeName
  + Float price
}

class Topping {
  + String id
  + String name
  + Float price
  + Integer stockQuantity
}

class Order {
  + String id
  + String orderCode
  + String userId
  + OrderStatus status
  + Float totalAmount
  + Float discountAmount
  + Float finalAmount
  + DateTime createdAt
  + DateTime updatedAt
}

class OrderItem {
  + String id
  + String orderId
  + String productId
  + String sizeId
  + Integer quantity
  + Float unitPrice
  + Float subtotal
}

class Payment {
  + String id
  + String orderId
  + String transactionId
  + Float amount
  + PaymentMethod paymentMethod
  + PaymentStatus status
  + String idempotencyKey
  + String gatewayResponse
  + DateTime createdAt
}

class Promotion {
  + String id
  + String code
  + String discountType
  + Float discountValue
  + Float minOrderValue
  + Float maxDiscountAmount
  + DateTime startDate
  + DateTime endDate
  + Integer usageLimit
  + Integer usedCount
  + Boolean isActive
}

class LoyaltyTransaction {
  + String id
  + String userId
  + String orderId
  + Integer points
  + String type
  + DateTime createdAt
}

User "1" --> "0..*" Order : places >
User "1" --> "0..*" LoyaltyTransaction : has >
Order "1" *-- "1..*" OrderItem : contains >
Product "1" --> "0..*" OrderItem : referenced in >
Product "1" --> "0..*" ProductSize : has sizes >
Product "1" --> "0..*" Topping : supports options >
OrderItem "1" --> "1" ProductSize : has size >
OrderItem "0..*" --> "0..*" Topping : includes toppings >
Order "1" --> "0..1" Payment : paid by >
Order "0..*" --> "0..1" Promotion : applies >
Order "1" --> "0..1" LoyaltyTransaction : generates >

@enduml