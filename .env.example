# ---- Database (PostgreSQL) ----
# Production/CI dùng DATABASE_URL. Local Compose có thể dùng POSTGRES_*.
DATABASE_URL=postgres://brewlite:brewlite@db:5432/brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- API ----
NODE_ENV=development
PORT=3001
# Chỉ chạy migration tự động ở local. Production chạy migration như bước riêng.
DB_MIGRATIONS_RUN=true
DB_LOGGING=false
# Origin bổ sung được phép gọi API, phân tách bằng dấu phẩy.
CORS_ORIGIN=http://localhost:3000
# IP mạng nội bộ của máy chủ demo; QR tự dùng IP này nếu trang mở bằng localhost.
LAN_HOST=192.168.1.12
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# Kết quả thanh toán giả lập: SUCCESS, FAILED hoặc TIMEOUT.
# Đổi giá trị cần khởi động lại API.
MOCK_PAYMENT_OUTCOME=SUCCESS
# Tùy chọn: tạo tài khoản nhân viên khi seed lần đầu. Không dùng mật khẩu mặc định.
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_STAFF_NAME=BrewLite Staff

# ---- Web ----
# Khi trang mở bằng localhost, QR dùng IP này để điện thoại mở được liên kết.
# NEXT_PUBLIC_* được nhúng lúc build; thay IP cần build lại image web.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_LAN_HOST=192.168.1.12