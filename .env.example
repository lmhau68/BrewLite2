# ---- Database (PostgreSQL) ----
# Production/CI dùng DATABASE_URL. Local Compose có thể dùng POSTGRES_*.
DATABASE_URL=postgres://brewlite:brewlite@db:5432/brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- API ----
NODE_ENV=development
PORT=3001
# Chỉ chạy migration tự động ở local. Production chạy migration như bước riêng.
DB_MIGRATIONS_RUN=true
DB_LOGGING=false
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy.
CORS_ORIGIN=http://localhost:3000

# ---- Web ----
# Biến NEXT_PUBLIC_* được nhúng lúc build, đổi URL API phải build lại image.
NEXT_PUBLIC_API_URL=http://localhost:3001