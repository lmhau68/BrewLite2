# ---- Database (PostgreSQL) ----
# Production/CI dùng DATABASE_URL. Local Compose có thể dùng POSTGRES_*.
DATABASE_URL=postgres://brewlite:brewlite@db:5432/brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- API ----
NODE_ENV=development
PORT=3001
# Chỉ chạy migration tự động ở local. Production chạy migration như bước riêng.
DB_MIGRATIONS_RUN=true
DB_LOGGING=false
# Origin bổ sung được phép gọi API, phân tách bằng dấu phẩy.
CORS_ORIGIN=http://localhost:3000
# IP mạng nội bộ của API demo.
LAN_HOST=192.168.1.12
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# VNPay Sandbox. IPN URL phải truy cập được công khai và được đăng ký trên merchant test.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_IPN_URL=
WEB_APP_URL=http://localhost:3000
# Tùy chọn: tạo tài khoản nhân viên khi seed lần đầu. Không dùng mật khẩu mặc định.
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_STAFF_NAME=BrewLite Staff

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:3001